APP_NAME=Arbi3
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

MYSQL_DATABASE=arbi3
MYSQL_USER=arbi3
MYSQL_PASSWORD=arbi3_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

DATABASE_URL=mysql+asyncmy://arbi3:arbi3_password@mysql:3306/arbi3?charset=utf8mb4
ALEMBIC_DATABASE_URL=mysql+pymysql://arbi3:arbi3_password@mysql:3306/arbi3?charset=utf8mb4

DEFAULT_COLLECTION_MODE=all
DEFAULT_QUOTE_INTERVAL_MS=1000
MIN_QUOTE_INTERVAL_MS=250
MAX_QUOTE_INTERVAL_MS=60000
SPREAD_BUCKET_FLUSH_SECONDS=10
SPREAD_WINDOW_REFRESH_SECONDS=60
SPREAD_BUCKET_RETENTION_HOURS=48

LOCAL_SETTINGS_PATH=local_data/settings.json
